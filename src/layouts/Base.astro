---
// সব page-এর কাঠামো: <head>, উপরের nav (React island), page, footer
import '../index.css';
import TopNav from '../components/TopNav.jsx';
import { url } from '../lib/nav.js';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'courses' | 'handbook' | 'lesson';
  courseId?: string;
  footer?: boolean;
}
const { title, description, active, courseId, footer = true } = Astro.props;
const site = 'Engineering Academy — বাংলায় দেখে-ছুঁয়ে শেখো';
const fullTitle = title ? `${title} · Engineering Academy` : site;
const desc = description || 'Networking, System Design ও Cyber Security — একদম শুরু থেকে, সহজ বাংলায়, 3D animation আর interactive lab দিয়ে।';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="bn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎓</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <script is:inline>
      // প্রথম paint-এর আগেই theme বসাও, যাতে সাদা-কালো ঝলক না দেখা যায়
      try { var t = localStorage.getItem('academy-theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    </script>
  </head>
  <body>
    <div class="ui flex min-h-screen flex-col">
      <TopNav client:load active={active} courseId={courseId} />
      <main class="fade-in flex-1"><slot /></main>
      {footer && (
        <footer class="no-print border-t border-line bg-panel">
          <div class="mx-auto grid max-w-[1180px] gap-8 px-4 py-8 text-[14.5px] sm:px-6 md:grid-cols-2">
            <div>
              <a href={url('')} class="flex items-center gap-2.5 text-base"><span class="bg-brandgrad grid size-7 place-items-center rounded-[9px] text-[15px]">🎓</span><b>Engineering Academy</b></a>
              <p class="mt-2 text-muted">প্রযুক্তির কঠিন বিষয় — সহজ বাংলায়, চোখে দেখে আর নিজের হাতে চালিয়ে শেখার জায়গা। সব simulation তোমার browser-এর ভেতরেই চলে, কোনো account লাগে না।</p>
              <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-muted">
                <a class="hover:text-ink" href={url('courses/')}>📚 কোর্স</a>
                <a class="hover:text-ink" href={url('handbook/')}>📌 চিটশিট</a>
              </p>
            </div>
            <div class="self-start rounded-2xl border border-warn/30 bg-warn/6 px-4 py-3.5">⚖️ <b>নৈতিকতা:</b> এখানের সব আক্রমণ কৌশল শেখানো হয় রক্ষা করার জন্য। বাস্তবে শুধু নিজের system বা লিখিত অনুমতি আছে এমন জায়গায় পরীক্ষা করবে।</div>
          </div>
        </footer>
      )}
    </div>
  </body>
</html>
